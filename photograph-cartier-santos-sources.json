      "title": "Condition"
    },
    {
      "_key": "cc50944c5586",
      "_type": "titleLeftBodyRight",
      "title": "Our Perspective",
      "bodyCopy": [
        {
          "_key": "485f341a75ff",
          "markDefs": [],
          "children": [
            {
              "marks": [],
              "text": "A wonderfully designed timepiece that blends tradition with a forward-looking ethos, the Santos de Cartier successfully celebrates Cartier's heritage while also enabling them to remain relevant and up to date on current market trends.  We especially love the quick-release bracelet on these newer Cartiers that make the strap switching a breeze.  ",
              "_key": "0e3e91fb2b3d",
              "_type": "span"
            }
          ],
          "_type": "block",
          "style": "normal"
        }
